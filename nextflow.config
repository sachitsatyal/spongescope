// Profiles differ in what they can afford, not in what they do.
//
//   test    GitHub Actions: CPU only, no GPU, no training. Proves the DAG wires up and the
//           SQL builds. Minutes, free.
//   kaggle  Kaggle GPU notebook: the full run including training. Hours, free, 12 h session cap.
//   local   the RTX 5090 workstation, if ever run under WSL.

manifest {
    name            = 'spongescope'
    description     = 'lncRNA-miRNA interaction prediction with leakage-free evaluation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
}

// Resume needs a stable work directory; without this a fresh checkout re-runs everything.
workDir = './work'

profiles {
    test {
        params.max_genes  = 50
        params.skip_train = true       // no GPU in Actions, and training is not what CI checks
        params.seeds      = [42]
        process {
            cpus   = 2
            memory = '6 GB'
            time   = '30 m'
        }
    }

    kaggle {
        params.skip_train = false
        params.seeds      = [1, 2, 42]
        process {
            cpus   = 4
            memory = '13 GB'           // Kaggle's limit; asking for more fails at submit time
            time   = '11 h'            // under the 12 h session cap, so a timeout is ours not theirs
            withLabel: 'gpu' { accelerator = 1 }
        }
    }

    local {
        params.skip_train = false
        params.seeds      = [42]
        process {
            cpus   = 8
            memory = '32 GB'
            withLabel: 'gpu' { accelerator = 1 }
        }
    }
}

// A run you cannot account for afterwards is a run you cannot defend. These are written on
// every execution and cost nothing.
timeline { enabled = true; file = "${params.outdir}/pipeline/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline/dag.html";      overwrite = true }
